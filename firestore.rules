rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.userId == request.auth.uid;
    }

    function isValidWorkspace(data) {
      return data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.settings is map &&
        data.keys().hasAll(['id', 'name', 'userId', 'createdAt', 'updatedAt', 'settings']) &&
        data.keys().hasOnly(['id', 'name', 'userId', 'createdAt', 'updatedAt', 'settings']);
    }

    // --- Workspaces Collection ---
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (existing().userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(workspaceId) &&
        incoming().id == workspaceId &&
        isValidWorkspace(incoming());

      allow update: if isSignedIn() && isValidId(workspaceId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        isValidWorkspace(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt', 'settings']);

      allow delete: if isSignedIn() && isValidId(workspaceId) && existing().userId == request.auth.uid;

      // Subcollection: Sources
      match /sources/{sourceId} {
        allow get: if isWorkspaceOwner(workspaceId) && isValidId(sourceId);
        allow list: if isWorkspaceOwner(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId) && isValidId(sourceId) &&
          incoming().id == sourceId &&
          incoming().workspaceId == workspaceId &&
          incoming().title is string && incoming().title.size() <= 256;
        allow update: if isWorkspaceOwner(workspaceId) && isValidId(sourceId) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId;
        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(sourceId);
      }

      // Subcollection: Candidates
      match /candidates/{candidateId} {
        allow get: if isWorkspaceOwner(workspaceId) && isValidId(candidateId);
        allow list: if isWorkspaceOwner(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId) && isValidId(candidateId) &&
          incoming().id == candidateId &&
          incoming().workspaceId == workspaceId;
        allow update: if isWorkspaceOwner(workspaceId) && isValidId(candidateId) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId;
        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(candidateId);
      }

      // Subcollection: Clips
      match /clips/{clipId} {
        allow get: if isWorkspaceOwner(workspaceId) && isValidId(clipId);
        allow list: if isWorkspaceOwner(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId) && isValidId(clipId) &&
          incoming().id == clipId &&
          incoming().workspaceId == workspaceId;
        allow update: if isWorkspaceOwner(workspaceId) && isValidId(clipId) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId;
        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(clipId);
      }

      // Subcollection: Jobs
      match /jobs/{jobId} {
        allow get: if isWorkspaceOwner(workspaceId) && isValidId(jobId);
        allow list: if isWorkspaceOwner(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId) && isValidId(jobId) &&
          incoming().id == jobId &&
          incoming().workspaceId == workspaceId;
        allow update: if isWorkspaceOwner(workspaceId) && isValidId(jobId) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId;
        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(jobId);
      }

      // Subcollection: Queue
      match /queue/{queueItemId} {
        allow get: if isWorkspaceOwner(workspaceId) && isValidId(queueItemId);
        allow list: if isWorkspaceOwner(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId) && isValidId(queueItemId) &&
          incoming().id == queueItemId &&
          incoming().workspaceId == workspaceId;
        allow update: if isWorkspaceOwner(workspaceId) && isValidId(queueItemId) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId;
        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(queueItemId);
      }
    }
  }
}
